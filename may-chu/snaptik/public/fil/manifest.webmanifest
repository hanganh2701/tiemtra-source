{
  "name": "snaptik: i-download ang TikTok video nang walang watermark",
  "short_name": "snaptik",
  "description": "I-download ang TikTok video nang walang watermark, sa HD, bilang MP3, at ang mga photo slideshow.",
  "lang": "fil",
  "id": "/",
  "start_url": "/fil/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fff8f0",
  "theme_color": "#f0682a",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/fil/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "I-download ang MP3",
      "url": "/fil/mp3/"
    },
    {
      "name": "I-download ang slideshow",
      "url": "/fil/anh/"
    }
  ]
}
