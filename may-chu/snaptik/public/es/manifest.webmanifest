{
  "name": "snaptik: descargar videos de TikTok sin marca de agua",
  "short_name": "snaptik",
  "description": "Descarga videos de TikTok sin marca de agua, en HD, música MP3 y carruseles de fotos.",
  "lang": "es",
  "id": "/",
  "start_url": "/es/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fff8f0",
  "theme_color": "#f0682a",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/es/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "Descargar música MP3",
      "url": "/es/mp3/"
    },
    {
      "name": "Descargar fotos",
      "url": "/es/anh/"
    }
  ]
}
