{
  "name": "snaptik: baixar vídeos do TikTok sem marca d'água",
  "short_name": "snaptik",
  "description": "Baixe vídeos do TikTok sem marca d'água, em HD, músicas em MP3 e fotos de slides.",
  "lang": "pt",
  "id": "/",
  "start_url": "/pt/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fff8f0",
  "theme_color": "#f0682a",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/pt/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "Baixar música MP3",
      "url": "/pt/mp3/"
    },
    {
      "name": "Baixar fotos de slides",
      "url": "/pt/anh/"
    }
  ]
}
