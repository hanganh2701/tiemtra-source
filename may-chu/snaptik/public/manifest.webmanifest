{
  "name": "snaptik: tải video TikTok không logo",
  "short_name": "snaptik",
  "description": "Tải video TikTok không logo, bản HD, nhạc MP3 và ảnh slide.",
  "lang": "vi",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fff6f8",
  "theme_color": "#ff3b6b",
  "icons": [
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    { "name": "Tải nhạc MP3", "url": "/mp3/" },
    { "name": "Tải ảnh slide", "url": "/anh/" }
  ]
}
